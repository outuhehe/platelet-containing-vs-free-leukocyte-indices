# Copy to config/db.env and edit:  Copy-Item config/db.env.example config/db.env
# db.env is local-only (listed in .gitignore); never commit or share it.

# PostgreSQL instance hosting both MIMIC-IV and eICU
PGHOST=127.0.0.1
PGPORT=5431

# Database names (two separate databases on the same instance)
MIMIC_DB=mimic
EICU_DB=eicu

# Credentials: a read-only role. Leave PGUSER/PGPASSWORD empty to fall back to
# matching %APPDATA%\postgresql\pgpass.conf by host/port/database/user.
PGUSER=
PGPASSWORD=

# All sessions are forced read-only via these startup options.
PG_READONLY_OPTIONS=-c default_transaction_read_only=on -c statement_timeout=0

# Working memory for heavy eICU queries (PostgreSQL size unit, e.g. 1GB)
PG_WORK_MEM=1GB
