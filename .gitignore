# Local credentials and environment — never commit
config/db.env

# Generated run artifacts (kept locally; regenerated by the pipeline)
outputs/logs/
*.tmp
tmp_*

# PhysioNet row-level data carrying pseudo-identifiers (subject_id/hadm_id/
# patientunitstayid/uniquepid). Keep local under the DUA; removing ID columns
# alone does not establish that row-level data are safe to disclose.
# Regenerated by the extraction stages (01, 02, 13, 14).
outputs/interim/
outputs/tables/eicu_sicu_patient_index_roster.csv
outputs/tables/eicu_sicu_external_validation_dataset.csv

# Platform-specific local package library (Windows binaries for offline runs).
# Kept locally; dependencies are installed from CRAN via install_pkgs.R instead.
Rlib/

# R / OS working files
.Rhistory
.RData
.Rproj.user/
.DS_Store
~$*
*.bak

# Defense in depth for historical export locations and ROC threshold files.
**/eicu_sicu_aligned_panels.csv
**/eicu_sicu_patient_index_roster.csv
**/eicu_sicu_external_validation_dataset.csv
**/roc_coords*.csv
**/db.env
**/pgpass.conf
